# Supabase — optional, powers the "Shared Group" feature.
# Copy to `.env.local` (it is git-ignored) or `.env`, then rebuild with EAS.
# Without these the app runs 100% offline and the Shared Group screen is hidden.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth for Gmail Banking Sync (optional, runs 100% on-device)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=