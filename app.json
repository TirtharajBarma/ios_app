{
  "expo": {
    "name": "Monevo",
    "slug": "subscription",
    "version": "1.1.8",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "monevo",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.tirtharajbarma.subscription",
      "userInterfaceStyle": "dark",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Authentication is required to unlock the app and access your financial details."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070A10",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "userInterfaceStyle": "dark",
      "navigationBar": {
        "backgroundColor": "#070A10",
        "barStyle": "light-content"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.tirtharajbarma.subscription",
      "allowBackup": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070A10",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 100
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "./plugins/with-ios-source-react-native",
      "./plugins/with-android-release-architectures",
      "./plugins/with-app-intents",
      "./plugins/with-android-app-shortcut",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-image",
      "expo-web-browser",
      "./plugins/with-ios-scene-lifecycle",
      "./plugins/with-ios-local-no-push",
      "./plugins/with-android-transaction-tracker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "inlineModules": {
        "watchedDirectories": [
          "app-intents"
        ]
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "382b12ce-7c53-4d52-9dd2-8206e0bdea03"
      },
      "supabaseUrl": "https://nvsjrfzzessvynnuurcg.supabase.co",
      "supabaseAnonKey": "sb_publishable_hmdnizlu8wzE6EwOj2IJvw_0mc9qG7J",
      "updateVersion": "v1.1.8",
      "updateDescription": "Fix Safe to spend amount visibility and smooth dynamic calendar carousel",
      "updateNotes": [
        "Fix Safe to spend amount visibility and smooth dynamic calendar carousel"
      ],
      "easUpdateMessage": "v1.1.8: Fix Safe to spend amount visibility and smooth dynamic calendar carousel"
    },
    "owner": "tirtharaj_barma",
    "runtimeVersion": "1",
    "updates": {
      "url": "https://u.expo.dev/382b12ce-7c53-4d52-9dd2-8206e0bdea03",
      "requestHeaders": {
        "expo-channel-name": "preview"
      },
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    }
  }
}
